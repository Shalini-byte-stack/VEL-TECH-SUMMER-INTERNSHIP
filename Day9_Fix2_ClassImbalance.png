      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv(\"HeartRate_Cleaned.csv\")\n",
        "\n",
        "# Create labels\n",
        "df['Label'] = df['heart_rate'].apply(\n",
        "    lambda x: 0 if x < 60 else (2 if x > 100 else 1)\n",
        ")\n",
        "\n",
        "# Count classes\n",
        "print(\"Class Distribution:\")\n",
        "print(df['Label'].value_counts())\n",
        "\n",
        "# Plot class distribution\n",
        "plt.figure(figsize=(6,4))\n",
        "df['Label'].value_counts().sort_index().plot(kind='bar')\n",
        "\n",
        "plt.xticks(\n",
        "    [0,1,2],\n",
        "    ['Bradycardia', 'Normal', 'Tachycardia'],\n",
        "    rotation=0\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Heart Rate Condition\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.title(\"Class Imbalance Analysis\")\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "# Save image\n",
        "plt.savefig(\"Day9_Fix2_ClassImbalance.png\")\n",
        "\n",
        "plt.show()"
      ],
