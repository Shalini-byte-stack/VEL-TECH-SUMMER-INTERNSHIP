        "def assign_risk(row):\n",
        "    score = 0\n",
        "    if row['heart_rate'] > 100 or row['heart_rate'] < 50:\n",
        "        score += 2\n",
        "    if row['spo2_level'] < 94:\n",
        "        score += 2\n",
        "    if row['blood_pressure_sys'] > 140 or row['blood_pressure_sys'] < 90:\n",
        "        score += 2\n",
        "    if row['blood_glucose'] > 180 or row['blood_glucose'] < 70:\n",
        "        score += 1\n",
        "    if row['body_temperature'] > 38.0 or row['body_temperature'] < 35.5:\n",
        "        score += 1\n",
        "    if row['respiration_rate'] > 20 or row['respiration_rate'] < 10:\n",
        "        score += 1\n",
        "    if row['fall_detected'] == 1:\n",
        "        score += 2\n",
        "    if row['stress_level_index'] > 70:\n",
        "        score += 1\n",
        "\n",
        "    if score <= 1:\n",
        "        return 'Low'\n",
        "    elif score <= 4:\n",
        "        return 'Medium'\n",
        "    else:\n",
        "        return 'High'\n",
        "\n",
        "df['risk_level'] = df.apply(assign_risk, axis=1)\n",
        "\n",
        "print(\"✅ Risk column created\")\n",
        "print(df['risk_level'].value_counts())"
