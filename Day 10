        "def predict(input_dict):\n",
        "    import pandas as pd\n",
        "    import joblib\n",
        "\n",
        "    # STEP 1 — Load all pkl files inside function\n",
        "    try:\n",
        "        model          = joblib.load(\"models/final_model.pkl\")\n",
        "        scaler         = joblib.load(\"models/scaler.pkl\")\n",
        "        label_enc      = joblib.load(\"models/label_encoder.pkl\")\n",
        "        activity_enc   = joblib.load(\"models/activity_encoder.pkl\")\n",
        "        feature_cols   = joblib.load(\"models/feature_columns.pkl\")\n",
        "        top_features   = joblib.load(\"models/top_features.pkl\")\n",
        "    except Exception as e:\n",
        "        return {\"error\": f\"Failed to load model files: {str(e)}\"}\n",
        "\n",
        "    # STEP 2 — Validate inputs\n",
        "    for field in feature_cols:\n",
        "        if field not in input_dict:\n",
        "            return {\"error\": f\"Missing field: '{field}'\"}\n",
        "\n",
        "    if input_dict.get('activity_type') not in list(activity_enc.classes_):\n",
        "        return {\"error\": f\"activity_type must be one of {list(activity_enc.classes_)}\"}\n",
        "\n",
        "    try:\n",
        "        if float(input_dict.get('heart_rate', 0)) < 0:\n",
        "            return {\"error\": \"heart_rate cannot be negative\"}\n",
        "    except (ValueError, TypeError):\n",
        "        return {\"error\": \"heart_rate must be a number\"}\n",
        "\n",
        "    # STEP 3 — Convert dict to DataFrame\n",
        "    try:\n",
        "        input_df = pd.DataFrame([input_dict])\n",
        "        input_df['activity_type'] = activity_enc.transform(input_df['activity_type'])\n",
        "        input_df = input_df[feature_cols]\n",
        "    except Exception as e:\n",
        "        return {\"error\": f\"Data preparation failed: {str(e)}\"}\n",
        "\n",
        "    # STEP 4 — Scale and Predict\n",
        "    try:\n",
        "        X_scaled       = scaler.transform(input_df)\n",
        "        pred_encoded   = model.predict(X_scaled)[0]\n",
        "        pred_proba     = model.predict_proba(X_scaled)[0]\n",
        "        confidence_pct = round(max(pred_proba) * 100, 1)\n",
        "    except Exception as e:\n",
        "        return {\"error\": f\"Prediction failed: {str(e)}\"}\n",
        "\n",
        "    # STEP 5 — Return clean dict\n",
        "    prediction_label = label_enc.inverse_transform([pred_encoded])[0]\n",
        "\n",
        "    return {\n",
        "        \"prediction\"  : prediction_label,\n",
        "        \"confidence\"  : f\"{confidence_pct}%\",\n",
        "        \"top_features\": top_features,\n",
        "        \"risk_level\"  : prediction_label\n",
        "    }\n",
        "\n",
        "print(\"✅ predict() function is ready!\")"
      ],
